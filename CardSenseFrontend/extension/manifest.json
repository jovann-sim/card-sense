{
  "manifest_version": 3,
  "name": "CardSense",
  "version": "0.1.0",
  "description": "Tells you which card to reach for at checkout. Advisory only — it never fills or stores a card number.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CardSense"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detect.js"],
      "run_at": "document_idle"
    }
  ]
}
