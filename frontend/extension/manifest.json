{
  "manifest_version": 3,
  "name": "CardSense",
  "version": "0.2.0",
  "description": "Tells you which card to reach for at checkout. Advisory only — it never fills, stores or transmits a card number.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CardSense"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "detect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
