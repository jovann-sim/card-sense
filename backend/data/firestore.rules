// Firestore rules: clients may read the public snapshot only through your
// preferred authenticated web-server pattern. Sensitive Plaid credentials are
// never readable from the browser.
// Deploy with Firebase/Firestore tooling after adapting auth to your project.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/plaid_items/{itemId} {
      allow read, write: if false;
    }
    match /users/{uid}/snapshots/{snapshotId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // All operational state is server-owned.  The HTTP API is the write
    // boundary; clients never receive raw transactions, rules, or advice.
    match /users/{uid}/{collection}/{document} {
      allow read, write: if false;
    }
    match /card_rules/{cardId} {
      allow read, write: if false;
    }
    match /mcc_map/{category} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
