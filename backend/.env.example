# Local storage mode. Plaid and Gemini are enabled independently by credentials.
DEMO_MODE=true

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
FINANCE_AGENT_MODEL=gemini-2.5-flash

# Firestore
FIRESTORE_DATABASE=(default)
SNAPSHOT_CACHE_TTL_SECONDS=10

# Plaid sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Scheduler / internal service authentication
INTERNAL_RUN_SECRET=change-me

# App
CORS_ORIGINS=http://localhost:3000
