# Local storage mode. Plaid and Gemini are enabled independently by credentials.
DEMO_MODE=true
PIPELINE_ENGINE=adk

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
FINANCE_AGENT_MODEL=gemini-2.5-flash
GEMINI_INPUT_USD_PER_MILLION=0.15
GEMINI_OUTPUT_USD_PER_MILLION=0.60
GEMINI_THINKING_USD_PER_MILLION=3.50

# Firestore
FIRESTORE_DATABASE=(default)
SNAPSHOT_CACHE_TTL_SECONDS=10

# Plaid sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Scheduler / internal service authentication
INTERNAL_RUN_SECRET=change-me

# App
CORS_ORIGINS=http://localhost:3000
